# Copie para .env e preencha os valores. Nunca commite o .env.
# DATABASE_URL local: Neon dev.
# Production (Supabase, variável da Vercel): Transaction pooler, porta 6543, terminando em
#   ?pgbouncer=true&connection_limit=1   — nunca o Session pooler (5432) em runtime (esgota o pool).
# Backup (pg_dump) e `prisma migrate resolve/status` em produção: porta 5432 (Session pooler),
#   num arquivo .env.producao-backup fora do git — nunca a 6543.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NextAuth lê apenas NEXTAUTH_SECRET (nome padrão).
NEXTAUTH_SECRET=
# Banco SÓ de testes (integração e e2e apagam dados). Nunca produção nem o mesmo host do DATABASE_URL.
# Local: branch "testes" no Neon. No GitHub Actions: Postgres temporário do próprio workflow.
TEST_DATABASE_URL=
# Feature flag da agenda nova (sexta/sábado da semana, grade fixa): off | admin | all. Padrão: off.
AGENDA_V2=off
# Feature flag da home nova (spec §4.1); com ela ligada, a home antiga fica em /classic: off | admin | all. Padrão: off.
NEW_HOME=off
# Feature flag do painel do admin (grade, bloqueios, reserva manual; spec §4.4): off | admin | all. Padrão: off.
ADMIN_PANEL_V2=off
# Feature flag dos mensalistas (aba do /adm; "all" também mostra a reserva na home do mensalista com conta): off | admin | all. Padrão: off.
MENSALISTAS=off
# Notificações (Prompt 19): e-mails de confirmação, lembrete da véspera e avisos, e o botão do WhatsApp: off | admin | all. Padrão: off.
# "admin" = só reservas/cancelamentos de quem é admin geram e-mail (teste em produção sem atingir clientes).
NOTIFICACOES=off
# "Adicionar ao calendário" (Prompt 20): Google Agenda + arquivo .ics na reserva e em "Meu próximo agendamento": off | admin | all. Padrão: off.
CALENDARIO=off
# PWA (Prompt 20): service worker (só assets) e dica "Adicionar à tela inicial": off | admin | all. Padrão: off.
# "off" também remove o SW de quem já o tem (o /sw.js vira um script que se desinstala).
PWA_INSTALL=off
# Web Push (Prompt 20): switch "Notificações no celular", lembrete da véspera e "o Cris cancelou" por push: off | admin | all.
WEB_PUSH=off
# Chaves VAPID: `npx web-push generate-vapid-keys`. Um par diferente em Preview e Production (trocar invalida as inscrições).
# VAPID_SUBJECT = mailto: da conta Gmail da barbearia. Sem as três, nenhum push sai.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Conta Gmail DEDICADA da barbearia (nunca a pessoal do Cris) e a senha de app de 16 letras (verificação em 2 etapas).
SMTP_USER=
SMTP_PASS=
# Segredo do Cron (/api/cron/notificacoes). A Vercel manda "Authorization: Bearer <CRON_SECRET>". Valor diferente em Preview e Production.
CRON_SECRET=
# Só na staging (Preview): e-mails separados por vírgula. Com a lista definida, ninguém fora dela recebe. Nunca em Production.
NOTIFY_ALLOWLIST=
