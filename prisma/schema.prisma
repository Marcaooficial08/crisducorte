// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
  isAdmin        Boolean   @default(false)
  emailReminders Boolean   @default(true) // opt-out só do lembrete da véspera (Prompt 19)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Barbershop {
  id       String    @id @default(uuid())
  name     String
  address  String
  imageUrl String
  phone    String? // WhatsApp do Cris (só dígitos, DDD + número); null = botão e link ocultos
  bookings Booking[]
  services Service[]
}

model Booking {
  id            String           @id @default(uuid())
  barbershopId  String
  barbershop    Barbershop       @relation(fields: [barbershopId], references: [id])
  serviceId     String
  service       Service          @relation(fields: [serviceId], references: [id])
  userId        String? // null = conta excluída pelo cliente (LGPD); a reserva fica sem dado pessoal
  user          User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  date          DateTime         @db.Timestamp
  customerName  String? // reserva manual sem conta (Fase 3); telas usam customerName ?? user.name
  customerPhone String?
  source        BookingSource    @default(CLIENT)
  mensalistaId  String?
  mensalista    Mensalista?      @relation(fields: [mensalistaId], references: [id])
  cycleId       String?
  cycle         MensalistaCycle? @relation(fields: [cycleId], references: [id])

  @@unique([barbershopId, date])
}

enum BookingSource {
  CLIENT // cliente pelo app
  MANUAL // Cris pelo painel
  MENSALISTA // gerada pelo horário fixo
}

// Uma linha por reserva cancelada (o cancelamento apaga a Booking). Sem FK: a reserva já não existe.
model BookingCancellation {
  id          String        @id @default(cuid())
  bookingId   String
  date        DateTime      @db.Timestamp // data + hora da reserva cancelada
  cancelledAt DateTime      @default(now())
  byAdmin     Boolean
  source      BookingSource

  @@index([date])
}

model SlotBlock {
  id        String   @id @default(cuid())
  date      DateTime @db.Timestamp // data + hora do horário bloqueado (mesmo tipo de Booking.date)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([date])
}

enum MensalistaStatus {
  ATIVO
  PAUSADO
  EXCLUIDO
}

model Mensalista {
  id        String            @id @default(cuid())
  name      String
  phone     String
  email     String? // liga ao User pelo e-mail, se existir
  fixedDay  Int? // 5 = sexta, 6 = sábado; null = reserva na mão
  fixedTime String? // "10:30"
  status    MensalistaStatus  @default(ATIVO)
  cycles    MensalistaCycle[]
  bookings  Booking[]
  createdAt DateTime          @default(now())
}

model MensalistaCycle {
  id           String     @id @default(cuid())
  mensalistaId String
  mensalista   Mensalista @relation(fields: [mensalistaId], references: [id])
  paidAt       DateTime // início do ciclo
  weekends     DateTime[] // as 4 sextas de referência do ciclo
  endsAt       DateTime // domingo após o 4º fim de semana
  renewedAt    DateTime?
  bookings     Booking[]
}

model Service {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  imageUrl     String
  bookings     Booking[]
}

model VerificationRequest {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

enum NotificationStatus {
  SENDING // reservada por quem vai enviar (trava contra envio duplicado)
  SENT
  FAILED
  SKIPPED // não enviada de propósito (ex.: reserva depois do Cron, fora da allowlist)
}

// Uma linha por notificação (Prompt 19). key única = idempotência: o mesmo evento nunca envia duas
// vezes. Sem e-mail nem texto (LGPD): só a chave, o tipo e o status.
model NotificationLog {
  id        String             @id @default(cuid())
  key       String             @unique // "confirm:<bookingId>", "reminder:<bookingId>", "renewal:<cycleId>"…
  kind      String
  status    NotificationStatus
  attempts  Int                @default(1)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sentAt    DateTime?

  @@index([status, updatedAt])
}
